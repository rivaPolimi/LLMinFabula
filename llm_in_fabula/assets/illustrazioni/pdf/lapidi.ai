         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">lapidi</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>MH Eamin Design</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">This set of Tombstone Vector Silhouettes is perfect for creating spooky Halloween designs. The pack contains 10 different tombstone silhouettes, each with intricate details and a creepy feel. Use them to add a touch of eeriness to your Halloween party invitations, flyers, or social media posts. These vectors are available in black, making them easy to incorporate into any design. With their high resolution and versatility, these tombstone silhouettes are sure to make your Halloween designs stand out.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Copyright 2023, All rights reserved, MH Eamin Design</rdf:li>
            </rdf:Alt>
         </dc:rights>
