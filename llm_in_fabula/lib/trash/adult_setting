class MoonRoleIcon extends StatelessWidget {
  final String fgAsset;
  final double iconScale;

  const MoonRoleIcon({
    super.key,
    required this.fgAsset,
    this.iconScale = 0.55,
  });

  @override
  Widget build(BuildContext context) {
    return LayoutBuilder(
      builder: (context, constraints) {
        final size = constraints.maxWidth < constraints.maxHeight
            ? constraints.maxWidth
            : constraints.maxHeight;

        return SizedBox(
          width: size,
          height: size,
          child: Stack(
            alignment: Alignment.center,
            children: [
              // 1. IMMAGINE DI SFONDO (Luna)
              // La ingrandiamo leggermente (1.05 = +5%) così "sborda" sotto la cornice
              Transform.scale(
                scale: 1.3,
                child: ClipOval(
                  child: Image.asset(
                    'assets/images/moon.png',
                    width: size,
                    height: size,
                    fit: BoxFit.cover,
                  ),
                ),
              ),

              // 2. IL BORDO (Sopra)
              // Disegna solo il cerchio colorato sopra l'immagine
              Container(
                width: size,
                height: size,
                decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  border: Border.all(
                    color: const Color(0xFF5D4D33),
                    width: 1.5, // Ho aumentato leggermente lo spessore per "coprire" meglio
                  ),
                ),
              ),

              // 3. ICONA PERSONAGGIO (Lupo, ecc.)
              Image.asset(
                fgAsset,
                width: size * iconScale,
                height: size * iconScale,
                fit: BoxFit.contain,
              ),
            ],
          ),
        );
      },
    );
  }
}

